{
  "name": "english-platform-for-lessons",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check:ui-redux": "node scripts/check-ui-redux-imports.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "validate:content": "tsx src/content/validate-cli.ts",
    "verify": "node scripts/verify-repository.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.9.0",
    "antd": "^5.27.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "dependency-cruiser": "^16.10.4",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^16.4.0",
    "js-yaml": "^4.1.0",
    "jsdom": "30.1.3",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.72.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "fast-uri": "3.1.9"
  }
}
